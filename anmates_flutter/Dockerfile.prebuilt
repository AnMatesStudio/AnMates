# syntax=docker/dockerfile:1.7
# CI image: serve a web bundle that was ALREADY built on the runner.
#
# CI (.github/workflows/ci.yml) needs the Flutter SDK anyway to analyze + test,
# so it runs `flutter build web` there and this image only packages the result —
# no Flutter toolchain in the build, no ~4 GB SDK image pull, build takes seconds.
#
# `Dockerfile` (next to this file) is the self-contained variant that compiles
# Flutter inside the image; docker-compose/start.sh use it so local dev doesn't
# need Flutter installed. Keep the nginx bits below in sync with it.
#
# Requires build/web to exist in the build context:
#   flutter build web --release --base-href /
FROM nginx:1.27-alpine
RUN rm -f /etc/nginx/conf.d/default.conf
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY build/web /usr/share/nginx/html
EXPOSE 80
# Use 127.0.0.1 (IPv4), not localhost: busybox wget resolves localhost to IPv6 ::1
# first, but nginx listens on IPv4 only → "connection refused" → stuck "unhealthy".
HEALTHCHECK --interval=15s --timeout=3s --start-period=10s --retries=3 \
  CMD wget -qO- http://127.0.0.1/ >/dev/null 2>&1 || exit 1
