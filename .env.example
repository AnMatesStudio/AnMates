# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:CHANGE_ME@db:5432/anmates
DB_PASS=CHANGE_ME

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_AT_LEAST_32_CHARS_LONG_xxxxxxxxx
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=168h

# ── API ───────────────────────────────────────────────────────────────────────
PORT=8080
ENV=production

# ── Firebase ──────────────────────────────────────────────────────────────────
# lấy từ Firebase Console > Project Settings > General > Web API Key
FIREBASE_WEB_API_KEY=CHANGE_ME

# ── Bản đồ / POI VN — provider cho danh sách "quán quanh đây" (Discovery) ──────
# Pluggable: chọn nguồn bằng MAP_PROVIDER ("goong" | "tomtom" | để trống = auto).
# Auto = ưu tiên Goong nếu có key, sau đó TomTom. Không provider nào có key →
# route /venues/nearby tắt → client fallback Overpass (OSM) như cũ.
MAP_PROVIDER=
#
# Goong (goong.io) — giải pháp thay Google Maps hợp pháp ở VN. Lấy key tại
# https://account.goong.io (free tier). Goong KHÔNG có ảnh → ảnh quán vẫn lấy qua
# pipeline ảnh sẵn có, dựa trên tên+địa chỉ chính xác từ Goong.
GOONG_API_KEY=
# (tuỳ chọn) Từ khoá fan-out cho Goong AutoComplete, phẩy ngăn cách. Mặc định:
# "nhà hàng,quán ăn,quán cà phê,quán nhậu,lẩu nướng".
GOONG_FOOD_KEYWORDS=
# (tuỳ chọn) Cache danh sách nearby Goong — Go duration (mặc định "10m"). 0 = tắt.
GOONG_NEARBY_CACHE_TTL=
#
# Goong Maptiles key — KHÁC với GOONG_API_KEY ở trên. Đây là key để render bản đồ
# tương tác (tab "Bản đồ") qua Goong Map Tiles (vector style goong_map_web.json).
# Lấy ở https://account.goong.io → "Maptiles Key". Nhúng client-side (Flutter web
# qua --dart-define=GOONG_MAPTILES_KEY=...); CI/CD lấy từ GH secret cùng tên. Bỏ
# trống = bản đồ trống (đã chọn "Goong tiles only", không có OSM fallback).
GOONG_MAPTILES_KEY=
#
# TomTom Search — nguồn thay thế. Key free ~2.500 request/ngày tại
# https://developer.tomtom.com. Để trống = không dùng TomTom.
TOMTOM_API_KEY=
#
# Foursquare Places (free SEARCH tier) — nguồn ẢNH "chính chủ" cho quán. Match quán
# theo tên + toạ độ → lấy website chính thức của quán → og:image (ảnh quán tự đăng).
# Lấy key free ở https://foursquare.com/developers. CHỈ dùng /places/search (free);
# KHÔNG dùng /photos (tính phí). Để trống = bỏ qua, dùng thẳng Bing + ảnh category.
FOURSQUARE_KEY=

# Cache ảnh thumbnail list (Bing) — Go duration. Bật (vd "24h") để mỗi quán luôn
# có ảnh ổn định, không re-crawl mỗi render. Để trống/0 = tắt cache (realtime).
VENUE_IMAGE_CACHE_TTL=24h

# ── Email OTP (passwordless login, alternative to phone OTP — no captcha) ─────
# When SMTP_HOST + SMTP_USERNAME are set the API emails real 6-digit codes via
# POST /api/v1/auth/email/{request-otp,verify-otp}. Leave them empty and the
# endpoints are only enabled in DEV_MODE (codes printed to the API logs).
# Gmail: create a Google App Password (Account → Security → 2-Step Verification →
# App passwords) and use it as SMTP_PASSWORD (NOT your normal Gmail password).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=you@gmail.com
# SMTP_PASSWORD=your_16_char_app_password
# SMTP_FROM=you@gmail.com
# SMTP_FROM_NAME=ĂnMates
# EMAIL_OTP_EXPIRE=10m
# EMAIL_OTP_RESEND_COOLDOWN=60s
# EMAIL_OTP_MAX_ATTEMPTS=5

# ── Flutter web ───────────────────────────────────────────────────────────────
# Cổng phục vụ Flutter web khi chạy qua docker-compose.
FLUTTER_WEB_PORT=54180
# URL backend cho Flutter web ở chế độ dev (build-time --dart-define).
API_BASE_URL=http://localhost:8080

# ── Dev flags (toggle here) ──────────────────────────────────────────────────
DEV_MODE=true
DEV_BYPASS_SECRET=dev-local-2026
DISABLE_RATE_LIMIT=1

# ── AI Concierge ──────────────────────────────────────────────────────────────
# Venue source is pluggable. Order of precedence in the API:
#   AI_SEARCH_URL set  → web-search path (ai_venue_search sidecar; FREE, no keys).
#   else AI_BASE_URL   → legacy DB+LLM path (needs a seeded restaurants table).
#   neither            → concierge DISABLED (chat works exactly as before).
#
# DEFAULT (recommended): the docker-compose `ai_venue_search` service provides this
# automatically at http://ai_venue_search:8090 — you don't need to set AI_SEARCH_URL
# here. Set it only to point at an external instance, or set it empty to fall back
# to the legacy AI_BASE_URL path. The sidecar itself is free + keyless (DuckDuckGo
# MCP search + an LLM structurer); tune it via the sidecar's own env vars in
# docker-compose.yml (or ai-venue-search/.env.example).
# AI_SEARCH_URL=http://ai_venue_search:8090
AI_TRIGGER_POINTS=70
# Structurer LLM runs fully in Docker via the bundled `ollama` service (no host
# model, no cloud). Pick the model tag here; first run pulls it (~2GB) into a volume.
#   STRUCTURER=pollinations → keyless cloud structurer instead of the local LLM.
#   OLLAMA_MODEL=qwen2.5:7b + OLLAMA_GPU=1 ./start.sh → bigger model on the GPU.
STRUCTURER=openai
OLLAMA_MODEL=qwen2.5:3b
# AI_DEFAULT_BUDGET_MIN=80000
# AI_DEFAULT_BUDGET_MAX=150000
# If the 2 matched users are farther apart than this (metres), the concierge skips
# the suggestion and posts a friendly "you're too far apart" notice instead of a bad
# midpoint card. Default 50000 (~25 km each way). Set 0 to disable the guard.
# AI_MAX_SEPARATION_M=50000
# AI_USER_ID=00000000-0000-0000-0000-0000000000a1
#
# Legacy DB+LLM fallback (only used when AI_SEARCH_URL is empty):
# AI_BASE_URL=http://host.docker.internal:1234/v1
# AI_API_KEY=lm-studio
# AI_MODEL=qwen/qwen3.5-9b
