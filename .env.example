# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:CHANGE_ME@db:5432/anmates
DB_PASS=CHANGE_ME

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_AT_LEAST_32_CHARS_LONG_xxxxxxxxx
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=168h

# ── API ───────────────────────────────────────────────────────────────────────
PORT=8080
ENV=production

# ── Firebase ──────────────────────────────────────────────────────────────────
# lấy từ Firebase Console > Project Settings > General > Web API Key
FIREBASE_WEB_API_KEY=CHANGE_ME

# ── Flutter web ───────────────────────────────────────────────────────────────
# Cổng phục vụ Flutter web khi chạy qua docker-compose.
FLUTTER_WEB_PORT=54180
# URL backend cho Flutter web ở chế độ dev (build-time --dart-define).
API_BASE_URL=http://localhost:8080

# ── Dev flags (toggle here) ──────────────────────────────────────────────────
DEV_MODE=true
DEV_BYPASS_SECRET=dev-local-2026
DISABLE_RATE_LIMIT=1

# ── AI Concierge ──────────────────────────────────────────────────────────────
# Venue source is pluggable. Order of precedence in the API:
#   AI_SEARCH_URL set  → web-search path (ai_venue_search sidecar; FREE, no keys).
#   else AI_BASE_URL   → legacy DB+LLM path (needs a seeded restaurants table).
#   neither            → concierge DISABLED (chat works exactly as before).
#
# DEFAULT (recommended): the docker-compose `ai_venue_search` service provides this
# automatically at http://ai_venue_search:8090 — you don't need to set AI_SEARCH_URL
# here. Set it only to point at an external instance, or set it empty to fall back
# to the legacy AI_BASE_URL path. The sidecar itself is free + keyless (DuckDuckGo
# MCP search + Pollinations structurer); tune it via the sidecar's own env vars in
# docker-compose.yml (or ai-venue-search/.env.example).
# AI_SEARCH_URL=http://ai_venue_search:8090
AI_TRIGGER_POINTS=70
# AI_DEFAULT_BUDGET_MIN=80000
# AI_DEFAULT_BUDGET_MAX=150000
# If the 2 matched users are farther apart than this (metres), the concierge skips
# the suggestion and posts a friendly "you're too far apart" notice instead of a bad
# midpoint card. Default 50000 (~25 km each way). Set 0 to disable the guard.
# AI_MAX_SEPARATION_M=50000
# AI_USER_ID=00000000-0000-0000-0000-0000000000a1
#
# Legacy DB+LLM fallback (only used when AI_SEARCH_URL is empty):
# AI_BASE_URL=http://host.docker.internal:1234/v1
# AI_API_KEY=lm-studio
# AI_MODEL=qwen/qwen3.5-9b
