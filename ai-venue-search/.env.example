# ============================================================================
# Defaults are 100% FREE, NO API KEYS, and need NO local model:
#   web search  → DuckDuckGo via MCP (uvx duckduckgo-mcp-server)
#   structurer  → Pollinations free OpenAI endpoint (github.com/zebbern/no-cost-ai)
# Leave everything as-is and it just works (only `uv` needs to be installed).
# ============================================================================

# ---- search provider (FREE) -------------------------------------------------
# mcp  → spawn an MCP web-search server over stdio and call its tool
# mock → deterministic offline venues (no network, no MCP) — for dev/tests
SEARCH_PROVIDER=mcp

# FREE + keyless DuckDuckGo MCP server (needs `uv`/`uvx` installed; in requirements).
# Set MCP_SERVER_CMD empty to force the mock search provider.
MCP_SERVER_CMD=uvx duckduckgo-mcp-server
MCP_SEARCH_TOOL=search
MCP_QUERY_ARG=query
# After searching, fetch the top N result pages so the model sees REAL venue names
# / addresses (snippets alone are mostly "Top 20 quán..." listicle titles). 0 = off.
MCP_FETCH_TOOL=fetch_content
MCP_FETCH_URL_ARG=url
MCP_FETCH_TOP_N=2
MCP_FETCH_CHAR_CAP=2500

# ---- geocoding (FREE, keyless, OpenStreetMap Nominatim) ---------------------
# Reverse-geocode the midpoint → place name (better query), and forward-geocode each
# picked venue → real lat/lng + address (so map pins land on the actual restaurant).
# Set 0 for fully-offline runs.
GEOCODE_ENABLED=1

# ---- structurer (FREE) ------------------------------------------------------
# pollinations → Pollinations free OpenAI endpoint, NO key, NO local model      ← default
# openai       → local LM Studio / Ollama (FREE, no key, more robust/private)
# anthropic    → Claude (needs ANTHROPIC_API_KEY, paid)
# mock         → naive offline extractor
STRUCTURER=pollinations

# Pollinations free tier works anonymously (~1 req/15s). A token (optional) lifts
# the rate limit — get one free at https://auth.pollinations.ai
POLLINATIONS_MODEL=openai
POLLINATIONS_TOKEN=

# Local model endpoint — only used when STRUCTURER=openai. Points at LM Studio on
# the host. No API key needed — LM Studio ignores Authorization.
LLM_BASE_URL=http://host.docker.internal:1234/v1
LLM_MODEL=qwen2.5-7b-instruct
LLM_API_KEY=

# Optional paid backend — only used when STRUCTURER=anthropic.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

REQUEST_TIMEOUT_S=55
