# cp .env.example .env && chmod 600 .env   (.env is gitignored)

# One-shot registration token: GitHub → repo Settings → Actions → Runners →
# "New self-hosted runner" → the value after `./config.sh ... --token`.
# Valid 1 hour, only read on FIRST start. Clear it once the runner shows Idle.
RUNNER_TOKEN=

# Written by scripts/make-deployer-kubeconfig.sh (= `id -g` of the user who ran it).
KUBECONFIG_GID=
